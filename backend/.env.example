SECRET_KEY=your-secret-key-here
DEBUG=False

# Comma-separated — required on VPS (e.g. pitty.fit,www.pitty.fit,your.server.ip)
ALLOWED_HOSTS=localhost,127.0.0.1,pitty.fit

# Comma-separated frontend origins (https in production)
CORS_ALLOWED_ORIGINS=https://pitty.fit,https://www.pitty.fit
CSRF_TRUSTED_ORIGINS=https://pitty.fit,https://www.pitty.fit

# If nginx does not serve /media/, set True so Django serves uploaded product images
SERVE_MEDIA=True

# Match nginx client_max_body_size (50M = 52428800)
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FRONTEND_URL=https://pitty.fit
